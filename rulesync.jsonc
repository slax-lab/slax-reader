{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": [
    "agentsmd",
    "claudecode",
    "codexcli"
  ],
  "features": [
    "rules",
    "permissions"
  ],
  "outputRoots": [
    "."
  ],
  // NEVER set this to true: with --delete, orphan sweep would remove
  // OpenSpec-managed skill dirs (e.g. .claude/skills/openspec-*) that share
  // generated directories with rulesync outputs.
  "delete": false,
  "verbose": false,
  "silent": false,
  "global": false,
  "simulateCommands": false,
  "simulateSubagents": false,
  "simulateSkills": false,
  "gitignoreTargetsOnly": true
}
