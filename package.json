{
  "name": "slax-reader",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "agent:sync": "rulesync generate",
    "agent:check": "rulesync doctor --strict && rulesync generate --check && openspec validate --all --strict && bash tooling/check-gh-aw-drift.sh",
    "prepare": "lefthook install",
    "dev:web": "pnpm --filter @apps/slax-reader-dweb dev",
    "build:web": "pnpm --filter @apps/slax-reader-dweb build",
    "test:web": "pnpm --filter @apps/slax-reader-dweb test",
    "typecheck:web": "pnpm --filter @apps/slax-reader-dweb typecheck"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.1",
    "lefthook": "^2.1.14",
    "rulesync": "16.39.1"
  }
}
