{
  "name": "slax-reader",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "agent:sync": "rulesync generate",
    "agent:check": "rulesync doctor --strict && rulesync generate --check && openspec validate --all --strict && bash tooling/check-gh-aw-drift.sh",
    "preflight": "node tooling/preflight.mjs",
    "test:preflight": "node --test tooling/preflight.test.mjs",
    "web": "node tooling/web.mjs",
    "extension": "node tooling/extension.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.1",
    "lefthook": "^2.1.14",
    "rulesync": "16.39.1"
  }
}
