# Slax Reader local Worker secrets — example
#
# Reference for maintainers of the internal local.zip bundle, which restores
# the real deploy/local/.dev.vars (gitignored). New team members receive the
# filled file through the bundle; see docs/LOCAL-SETUP.md.
#
# setup validates the file: all four keys must be non-empty, and
# POWERSYNC_JWK_PRIVATE_KEY must be a single-line RSA private JWK (including
# kid) capable of RS256 signing.

JWT_SECRET_TEXT=
HASH_IDS_SALT=
EDGE_SHARED_SECRET=
POWERSYNC_JWK_PRIVATE_KEY=
