# Slax Reader 浏览器扩展本地环境示例
#
# 使用方式：复制为 deploy/local_extension/.env；开发环境的覆盖配置可放在 deploy/local_extension/.env.dev。
# 根目录的 pnpm extension 命令会按 .env → .env.dev（或 .env.<SLAX_ENV>）加载；
# .env.dev 覆盖 .env，终端中已经设置的同名变量优先。
# 这里只放公开配置和占位值，不要填写真实密钥，也不要提交复制后的 .env 文件。

# 环境 profile（可选）。优先读取终端变量，其次此基础 .env，默认 development。
# development 读取 .env.dev，其他环境读取 .env.preview / .env.beta / .env.production。
# 不要在 profile 文件中改变 SLAX_ENV。切换 profile 也可在运行命令前设置：
#   SLAX_ENV=preview pnpm extension -- build
SLAX_ENV=development

# ── 应用地址 ────────────────────────────────────────────────────────────────
# 以下三个地址必填。
# Web 地址也是扩展 /x/ext-bridge 所属的 origin；登录和分享入口通常与 Web 相同。
PUBLIC_BASE_URL=http://localhost:3000
AUTH_BASE_URL=http://localhost:3000
SHARE_BASE_URL=http://localhost:3000

# ── backend API ─────────────────────────────────────────────────────────────
# EXTENSIONS_API_BASE_URL 必填。
# 本地 backend API 的地址；真实登录、同步和评论需要 Web 与 backend 都可访问。
EXTENSIONS_API_BASE_URL=http://localhost:8787

# ── Cookie ───────────────────────────────────────────────────────────────────
# 以下两个 Cookie 配置必填。
# 必须与 Web 使用相同的主机名和 cookie 名称，否则登录状态无法共享。
COOKIE_DOMAIN=localhost
COOKIE_TOKEN_NAME=slax_test

# ── 可选统计与卸载反馈 ───────────────────────────────────────────────────────
# Google Analytics 公共 measurement ID；不启用统计时留空。
GOOGLE_ANALYTICS_MEASUREMENT_ID=
# 通常留空。它可能进入扩展构建产物，不要填写服务端密钥或生产私密值。
GOOGLE_ANALYTICS_API_SECRET=
# 卸载反馈页面；不需要时留空。示例地址只用于本地占位。
UNINSTALL_FEEDBACK_URL=http://localhost:3000/uninstall

# ── 高级开发选项 ─────────────────────────────────────────────────────────────
# dev 模式是否生成 source map；需要调试源码时设为 1/true，默认关闭以加快构建。
SLAX_SOURCEMAP=0

# 以下变量仅供 offscreen / Chromium 自动化测试使用，普通开发和构建无需配置：
# CHROME_PATH=/absolute/path/to/chromium
# HEADLESS=1
# OFFSCREEN_TEST_FAST=1
