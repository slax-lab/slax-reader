# Copy to deploy/mobile/.env. Shell/CI values take precedence.
# Firebase and keystore paths are detected from the default directory layout.
# Optional path overrides are resolved relative to the repository root:
# SLAX_MOBILE_FIREBASE_IOS_CONFIG=deploy/mobile/ios/GoogleService-Info.plist
# SLAX_MOBILE_FIREBASE_ANDROID_CONFIG=deploy/mobile/android/google-services.json
# SLAX_ANDROID_KEYSTORE_PATH=deploy/mobile/android/slax-reader.release.jks

# Use the existing publisher key's credentials. Never generate replacement values.
# Quote passwords containing spaces or # characters. Values are not shell-expanded.
SLAX_ANDROID_KEYSTORE_PASSWORD=
SLAX_ANDROID_KEY_ALIAS=
SLAX_ANDROID_KEY_PASSWORD=

# iOS uses the existing Xcode account's team.
# SLAX_APPLE_TEAM_ID=
