{
  "name": "@apps/slax-reader-dweb",
  "private": true,
  "type": "module",
  "version": "2.0.11",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "type": "nuxt prepare",
    "type:wrangler": "BT=\"$(pnpm exec jiti ./config/backend-path.ts prodToml)\" && wrangler types -c ./wrangler.toml -c \"$BT\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:raw": "vitest run --coverage --config vitest.raw.config.ts",
    "lint:fix": "eslint .  --fix",
    "update:nuxt": "pnpm nuxt prepare",
    "ssr:dev": "pnpm build && rm -f .wrangler/deploy/config.json && SD=\"$(pnpm exec jiti ./config/backend-path.ts stateDir)\" && pnpm wrangler pages dev --port 3000 --inspector-port 9333 --persist-to \"$SD\"",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @slax-reader/selection build",
    "predev": "pnpm --filter @slax-reader/selection build",
    "prebuild": "pnpm --filter @slax-reader/selection build",
    "pretest": "pnpm --filter @slax-reader/selection build"
  },
