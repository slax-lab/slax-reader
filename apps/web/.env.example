# Slax Reader Web（DWeb）本地环境示例
#
# 使用方式：复制为 apps/web/.env，或复制为 apps/web/.env.development.local。
# loader 会按 .env → .env.<SLAX_ENV> → .env.<SLAX_ENV>.local 加载；
# 已在终端设置的变量优先，后面的文件不会覆盖前面文件中已经出现的同名变量。
# 这里只放公开配置和占位值，不要填写真实密钥，也不要提交复制后的 .env 文件。

# 环境 profile。切换 profile 时建议在运行命令前设置：
#   SLAX_ENV=preview pnpm web -- build
SLAX_ENV=development

# ── 应用地址 ────────────────────────────────────────────────────────────────
# Web 页面、登录入口和分享入口。无 backend 时也可以先用 localhost 做构建检查。
PUBLIC_BASE_URL=http://localhost:3000
AUTH_BASE_URL=http://localhost:3000
SHARE_BASE_URL=http://localhost:3000

# ── backend API ─────────────────────────────────────────────────────────────
# 本地 backend API 的地址；真实登录、同步和评论需要可访问的 backend。
DWEB_API_BASE_URL=http://localhost:8787

# ── Cookie ───────────────────────────────────────────────────────────────────
# COOKIE_DOMAIN 应与访问 Web 的主机名一致；COOKIE_TOKEN_NAME 至少 5 个字符。
COOKIE_DOMAIN=localhost
COOKIE_TOKEN_NAME=slax_test

# ── OAuth / Turnstile 公共配置 ───────────────────────────────────────────────
# Google 登录必填：
# 1. 打开 https://console.cloud.google.com/，创建或选择一个项目。
# 2. 在 APIs & Services > OAuth consent screen 中完成应用信息配置。
# 3. 在 APIs & Services > Credentials > Create Credentials > OAuth client ID 中，
#    选择 Web application。
# 4. Authorized JavaScript origins 填 PUBLIC_BASE_URL（例如 http://localhost:3000）。
# 5. Authorized redirect URIs 填 AUTH_BASE_URL/auth（例如 http://localhost:3000/auth）。
# 6. 复制生成的 Client ID；这里只填写 Client ID，不要把 Client Secret 放进前端文件。
GOOGLE_OAUTH_CLIENT_ID=

# Apple 登录可选；留空时 Web 登录界面不会显示 Apple 登录按钮。
APPLE_OAUTH_CLIENT_ID=

# Turnstile 可选；留空时相关流程不会渲染 Turnstile，也不会等待 Token。
TURNSTILE_SITE_KEY=

# ── 可选 Web 能力 ────────────────────────────────────────────────────────────
# Web Push 的 VAPID 公钥；不使用 Web Push 时留空。
PUSH_API_PUBLIC_KEY=
# Google Tag Manager 容器 ID；development profile 默认不启用真实 GTM。
GTM_CONTAINER_ID=

# fork 中的 Stripe 付费配置；需要付费功能时再填写对应的公开 price/key。
# 这些值必须使用 price_ / pk_ 开头，且不要把 Stripe 私钥放入前端环境文件。
STRIPE_ONCE_PRICE_ID=
STRIPE_SUB_PRICE_ID=
STRIPE_ONTIME_PRICE_ID=
STRIPE_PUBLIC_KEY=

# ── 本地 backend 联调 ────────────────────────────────────────────────────────
# 仅 `pnpm web -- dev` 需要；prepare、类型检查、测试和普通 build 可以留空。
# 填写独立 slax-reader-backend 检出的绝对路径，并确保其中已有 Wrangler 本地状态。
SLAX_BACKEND_DIR=

# ── 高级开发选项 ─────────────────────────────────────────────────────────────
# 仅在需要覆盖 wrangler.toml 中的 backend service 名称时设置。
BACKEND_SERVICE_NAME=
# 仅 dev 模式使用；设为 1/true 可启用开发 Service Worker，默认关闭。
ENABLE_DEV_SW=0
