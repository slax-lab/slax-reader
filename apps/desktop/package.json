{
  "name": "@slax-reader/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node tooling/dev.mjs --env local",
    "build": "node tooling/bundle.mjs --env main --host",
    "frontend:dev": "node tooling/assets.mjs && vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:core": "cargo test -p slax-core",
    "ipc:generate": "node tooling/ipc.mjs",
    "ipc:check": "node tooling/ipc.mjs --check",
    "check": "node tooling/check.mjs",
    "bundle": "node tooling/bundle.mjs",
    "release": "node tooling/release.mjs",
    "dev:local": "node tooling/dev.mjs --env local",
    "build:local": "node tooling/bundle.mjs --env local --host",
    "dev:preview": "node tooling/dev.mjs --env preview",
    "build:preview": "node tooling/bundle.mjs --env preview --host",
    "dev:beta": "node tooling/dev.mjs --env beta",
    "build:beta": "node tooling/bundle.mjs --env beta --host",
    "dev:main": "node tooling/dev.mjs --env main",
    "build:main": "node tooling/bundle.mjs --env main --host",
    "frontend:build": "node tooling/assets.mjs && vite build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@slax-reader/contracts": "workspace:*",
    "@slax-reader/reader-embed": "workspace:*",
    "vue": "3.5.42",
    "pinia": "4.0.3",
    "vue-i18n": "11.4.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.4",
    "typescript": "6.0.2",
    "vue-tsc": "3.3.4",
    "vitest": "3.2.7",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "20.8.4",
    "@types/node": "25.6.0",
    "esbuild": "0.28.2"
  }
}
