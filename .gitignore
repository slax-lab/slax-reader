# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/

# Node dependencies
# A trailing slash matches directories only, so a symlink named node_modules
# (e.g. one created inside a git worktree to reuse the main checkout's deps)
# would be committed and then break `pnpm install` in CI.
node_modules

# Build output
dist/
build/
*.tsbuildinfo

# Test coverage
coverage/

# Logs
*.log
logs/

# Env files / secrets -- never commit these, this repo is public
.env
.env.*
.dev.vars
.dev.vars.*
!.env.example
!.env.sample

# Kimi Code CLI Tower mode local tooling state
.tower/

# Task worktrees (parallel-work convention, see AGENTS.md)
.worktrees/
# Legacy singular path, kept until the last old-path worktree is removed: an
# unignored worktree directory is staged by `git add -A` as an embedded
# repository, so this line has to outlive the rename.
.worktree/

# Agent tooling: personal/local files (generated artifacts ARE committed on purpose)
rulesync.local.jsonc
.rulesync.local/
.rulesync/rules/.curated/
.rulesync/rules/*.local.md
AGENTS.local.md
CLAUDE.local.md
.claude/settings.local.json
.kimi-code/local.toml
